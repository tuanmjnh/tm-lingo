# Runtime
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# Client (public, safe to expose via Vite)
VITE_APP_NAME=TM-Lingo
VITE_DEFAULT_INTERFACE_LOCALE=vi
VITE_DEFAULT_LEARNING_LOCALE=en

# Firebase Cloud Messaging (Web Push certificate key pair from Firebase Console)
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Standard W3C Web Push (VAPID — server-only private key)
VAPID_SUBJECT=mailto:admin@tm-lingo.local
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# MongoDB (server-only)
MONGODB_URI=
MONGODB_DATABASE=tm_lingo

# Optional Supabase Auth & Storage
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI Provider (server-only)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Object Storage / CDN (server-only)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Security (server-only)
SESSION_SECRET=

# Seeded System Admin (server-only, optional overrides)
SEED_ADMIN_EMAIL=admin@tm-lingo.app
SEED_ADMIN_PASSWORD=

