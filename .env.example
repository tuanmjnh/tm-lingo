# Runtime
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
CAPACITOR_SERVER_URL=https://app.tm-lingo.app

# MongoDB — Primary Application Database (server-only)
MONGODB_URI=
MONGODB_DATABASE=tm_lingo

# Encryption Key for Self-Managed AI & Storage Providers (32-byte base64: openssl rand -base64 32)
AI_CONFIG_SECRET=

# TM-Hub Control Plane — Staff IAM, RBAC, Staff Users & Audit Logs (server-only)
HUB_BASE_URL=
HUB_APP_ID=tm-lingo
HUB_DEVICE_ID=
HUB_DEVICE_SECRET=
HUB_APP_SECRET=

# Local Staff Fallback (optional, ONLY when HUB_BASE_URL is not configured in local dev)
SEED_ROOT_EMAIL=root@tm-lingo.app
SEED_ROOT_PASSWORD=
SEED_ADMIN_EMAIL=admin@tm-lingo.app
SEED_ADMIN_PASSWORD=

# Standard W3C Web Push (VAPID — server-only private key)
VAPID_SUBJECT=mailto:admin@tm-lingo.local
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional Firebase Cloud Messaging public VAPID key
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# AI Provider Fallback (server-only, used when MongoDB ai_connections has no active connection)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-4-hydrogen
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts

# Object Storage / Cloudflare R2 / S3-Compatible Fallback (server-only)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=

# Session Signing Secret (server-only)
SESSION_SECRET=
