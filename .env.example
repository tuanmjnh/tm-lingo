# Runtime
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
CAPACITOR_SERVER_URL=https://app.tm-lingo.app

# Client (public, safe to expose via Vite / Next.js)
VITE_APP_NAME=TM-Lingo
VITE_DEFAULT_INTERFACE_LOCALE=vi
VITE_DEFAULT_LEARNING_LOCALE=en

# MongoDB — Primary Application Database (server-only)
MONGODB_URI=
MONGODB_DATABASE=tm_lingo

# Optional Supabase Auth & Storage (if pairing with external Supabase project)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Encryption Key for Self-Managed AI & Storage Providers (32-byte base64: openssl rand -base64 32)
AI_CONFIG_SECRET=

# TM-Hub Control Plane — Staff IAM, RBAC, Staff Users & Audit Logs
AUTH_PROVIDER=hub
VITE_PUBLIC_HUB_URL=https://tm-hub-app.vercel.app
VITE_PUBLIC_HUB_APP_ID=tm-lingo
AUTH_JWT_SECRET=
VITE_HUB_APP_SECRET=
HUB_DEVICE_ID=
HUB_DEVICE_SECRET=
# Aliases also supported:
# HUB_BASE_URL / NEXT_PUBLIC_HUB_URL (maps to VITE_PUBLIC_HUB_URL)
# HUB_APP_ID / NEXT_PUBLIC_HUB_APP_ID (maps to VITE_PUBLIC_HUB_APP_ID)
# HUB_APP_SECRET (maps to VITE_HUB_APP_SECRET)

# Local Staff Fallback (optional, ONLY when Hub URL is not configured in local dev)
SEED_ROOT_EMAIL=root@tm-lingo.app
SEED_ROOT_PASSWORD=
SEED_ADMIN_EMAIL=admin@tm-lingo.app
SEED_ADMIN_PASSWORD=

# Standard W3C Web Push (VAPID — server-only private key)
VAPID_SUBJECT=mailto:admin@tm-lingo.local
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional Firebase Cloud Messaging public VAPID key
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# AI Provider Fallback (server-only, used when MongoDB ai_connections has no active connection)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Object Storage / Cloudflare R2 / S3-Compatible Fallback (server-only)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=assets
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=

# Session Signing Secret (server-only)
SESSION_SECRET=
