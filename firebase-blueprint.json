{
  "entities": {
    "ParentAccount": {
      "title": "ParentAccount",
      "description": "Root authenticated consumer account document (family parent manager or independent middle/high school student).",
      "type": "object",
      "properties": {
        "parentId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the account owner."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Account display label."
        },
        "accountType": {
          "type": "string",
          "enum": ["parent", "student"],
          "maxLength": 16,
          "description": "Consumer account mode: parent (family manager for ages 3-11) or student (independent self-study for ages 12-18)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["parentId", "displayName", "accountType", "createdAt", "updatedAt"]
    },
    "LearnerProfile": {
      "title": "LearnerProfile",
      "description": "K-12 learner profile (ages 3-18) with grade level, curriculum ageBand, and independent multilingual locale preferences.",
      "type": "object",
      "properties": {
        "learnerId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "parentId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "nickname": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "ageYears": {
          "type": "integer",
          "minimum": 3,
          "maximum": 18
        },
        "ageBand": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "gradeLevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "avatarTone": {
          "type": "string",
          "enum": ["sky", "amber", "emerald", "rose"],
          "maxLength": 16
        },
        "interfaceLocale": {
          "type": "string",
          "minLength": 2,
          "maxLength": 10
        },
        "learningLocale": {
          "type": "string",
          "minLength": 2,
          "maxLength": 10
        },
        "explanationLocale": {
          "type": "string",
          "minLength": 2,
          "maxLength": 10
        },
        "narrationLocale": {
          "type": "string",
          "minLength": 2,
          "maxLength": 10
        },
        "reducedMotion": {
          "type": "boolean"
        },
        "dailyMinutesLimit": {
          "type": "integer",
          "minimum": 5,
          "maximum": 180
        },
        "storyDailyMinutesLimit": {
          "type": "integer",
          "minimum": 5,
          "maximum": 120
        },
        "audioSpeed": {
          "type": "number",
          "minimum": 0.65,
          "maximum": 1.5
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "learnerId",
        "parentId",
        "nickname",
        "ageYears",
        "ageBand",
        "gradeLevel",
        "avatarTone",
        "interfaceLocale",
        "learningLocale",
        "explanationLocale",
        "narrationLocale",
        "reducedMotion",
        "dailyMinutesLimit",
        "storyDailyMinutesLimit",
        "audioSpeed",
        "createdAt",
        "updatedAt"
      ]
    },
    "LessonProgress": {
      "title": "LessonProgress",
      "description": "Checkpoint progress record keyed by learner, lesson, locale, and experience mode.",
      "type": "object",
      "properties": {
        "progressId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "parentId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "learnerId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "lessonId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "learningLocale": {
          "type": "string",
          "minLength": 2,
          "maxLength": 10
        },
        "mode": {
          "type": "string",
          "enum": ["guided", "flashcards", "listening", "game", "story", "explore"],
          "maxLength": 16
        },
        "completedActivityIds": {
          "type": "array"
        },
        "totalActivities": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "lastActivityIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "completed": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "progressId",
        "parentId",
        "learnerId",
        "lessonId",
        "learningLocale",
        "mode",
        "completedActivityIds",
        "totalActivities",
        "lastActivityIndex",
        "completed",
        "createdAt",
        "updatedAt"
      ]
    },
    "StoryPosition": {
      "title": "StoryPosition",
      "description": "Saved reading position per learner and story.",
      "type": "object",
      "properties": {
        "positionId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "parentId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "learnerId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "storyId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "narrationLocale": {
          "type": "string",
          "minLength": 2,
          "maxLength": 10
        },
        "segmentIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "positionId",
        "parentId",
        "learnerId",
        "storyId",
        "narrationLocale",
        "segmentIndex",
        "createdAt",
        "updatedAt"
      ]
    },
    "FamilyInvite": {
      "title": "FamilyInvite",
      "description": "Short-lived 6-character invite code generated by an independent student account so a parent can link in read-only observer mode.",
      "type": "object",
      "properties": {
        "inviteCode": {
          "type": "string",
          "minLength": 6,
          "maxLength": 6,
          "pattern": "^[A-Z0-9]{6}$"
        },
        "studentUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "ageYears": {
          "type": "integer",
          "minimum": 3,
          "maximum": 18
        },
        "ageBand": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "gradeLevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "status": {
          "type": "string",
          "enum": ["active", "claimed", "revoked"],
          "maxLength": 16
        },
        "claimedByParentUid": {
          "type": "string",
          "maxLength": 128
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "inviteCode",
        "studentUid",
        "studentName",
        "ageYears",
        "ageBand",
        "gradeLevel",
        "status",
        "claimedByParentUid",
        "expiresAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "ObserverLink": {
      "title": "ObserverLink",
      "description": "Read-only parent observer link to an independent student's non-PII learning summary.",
      "type": "object",
      "properties": {
        "linkId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "parentUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "parentDisplayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "studentName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "ageYears": {
          "type": "integer",
          "minimum": 3,
          "maximum": 18
        },
        "ageBand": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "gradeLevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "avatarTone": {
          "type": "string",
          "enum": ["sky", "amber", "emerald", "rose"],
          "maxLength": 16
        },
        "inviteCode": {
          "type": "string",
          "minLength": 6,
          "maxLength": 6,
          "pattern": "^[A-Z0-9]{6}$"
        },
        "completedLessonsCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        },
        "totalActivitiesCompleted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50000
        },
        "currentStreakDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3650
        },
        "dailyMinutesGoal": {
          "type": "integer",
          "minimum": 5,
          "maximum": 180
        },
        "status": {
          "type": "string",
          "enum": ["active", "revoked"],
          "maxLength": 16
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "linkId",
        "parentUid",
        "studentUid",
        "parentDisplayName",
        "studentName",
        "ageYears",
        "ageBand",
        "gradeLevel",
        "avatarTone",
        "inviteCode",
        "completedLessonsCount",
        "totalActivitiesCompleted",
        "currentStreakDays",
        "dailyMinutesGoal",
        "status",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/parents/{parentId}": {
      "schema": { "$ref": "#/entities/ParentAccount" },
      "description": "Authenticated consumer account root documents (parent or independent student)."
    },
    "/parents/{parentId}/learners/{learnerId}": {
      "schema": { "$ref": "#/entities/LearnerProfile" },
      "description": "K-12 learner profiles (ages 3-18) owned by an account."
    },
    "/parents/{parentId}/progress/{progressId}": {
      "schema": { "$ref": "#/entities/LessonProgress" },
      "description": "Per-learner lesson progress checkpoints."
    },
    "/parents/{parentId}/storyPositions/{positionId}": {
      "schema": { "$ref": "#/entities/StoryPosition" },
      "description": "Per-learner story and audiobook reading positions."
    },
    "/familyInvites/{inviteCode}": {
      "schema": { "$ref": "#/entities/FamilyInvite" },
      "description": "One-time 6-character invite codes issued by independent student accounts for parent read-only linking."
    },
    "/observerLinks/{linkId}": {
      "schema": { "$ref": "#/entities/ObserverLink" },
      "description": "Non-PII read-only observer links between a parent account and an independent student account."
    }
  }
}
