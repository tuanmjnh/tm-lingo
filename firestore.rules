rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidShortId(id) {
      return id is string && id.size() >= 1 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidAgeBand(band) {
      return band is string && band.size() >= 1 && band.size() <= 32 && band.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidInviteCode(code) {
      return code is string && code.size() == 6 && code.matches('^[A-Z0-9]{6}$');
    }

    function isValidLocale(code) {
      return code is string && code.size() >= 2 && code.size() <= 10 && code.matches('^[a-zA-Z\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isVerifiedOwner(parentId) {
      return isVerifiedUser() && request.auth.uid == parentId;
    }

    function parentExists(parentId) {
      return exists(/databases/$(database)/documents/parents/$(parentId));
    }

    function isValidParentAccount(data, parentId) {
      return data.keys().hasAll(['parentId', 'displayName', 'accountType', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['parentId', 'displayName', 'accountType', 'createdAt', 'updatedAt'])
        && data.parentId == request.auth.uid
        && data.parentId == parentId
        && isValidId(data.parentId)
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 80
        && data.accountType is string
        && data.accountType.size() <= 16
        && data.accountType in ['parent', 'student']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLearnerProfile(data, parentId, learnerId) {
      return data.keys().hasAll([
          'learnerId',
          'parentId',
          'nickname',
          'ageYears',
          'ageBand',
          'gradeLevel',
          'avatarTone',
          'interfaceLocale',
          'learningLocale',
          'explanationLocale',
          'narrationLocale',
          'reducedMotion',
          'dailyMinutesLimit',
          'storyDailyMinutesLimit',
          'audioSpeed',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'learnerId',
          'parentId',
          'nickname',
          'ageYears',
          'ageBand',
          'gradeLevel',
          'avatarTone',
          'interfaceLocale',
          'learningLocale',
          'explanationLocale',
          'narrationLocale',
          'reducedMotion',
          'dailyMinutesLimit',
          'storyDailyMinutesLimit',
          'audioSpeed',
          'createdAt',
          'updatedAt'
        ])
        && data.parentId == request.auth.uid
        && data.parentId == parentId
        && data.learnerId == learnerId
        && isValidShortId(data.learnerId)
        && data.nickname is string
        && data.nickname.size() >= 1
        && data.nickname.size() <= 32
        && data.ageYears is int
        && data.ageYears >= 3
        && data.ageYears <= 18
        && isValidAgeBand(data.ageBand)
        && data.gradeLevel is int
        && data.gradeLevel >= 0
        && data.gradeLevel <= 12
        && data.avatarTone is string
        && data.avatarTone.size() <= 16
        && data.avatarTone in ['sky', 'amber', 'emerald', 'rose']
        && isValidLocale(data.interfaceLocale)
        && isValidLocale(data.learningLocale)
        && isValidLocale(data.explanationLocale)
        && isValidLocale(data.narrationLocale)
        && data.reducedMotion is bool
        && data.dailyMinutesLimit is int
        && data.dailyMinutesLimit >= 5
        && data.dailyMinutesLimit <= 180
        && data.storyDailyMinutesLimit is int
        && data.storyDailyMinutesLimit >= 5
        && data.storyDailyMinutesLimit <= 120
        && (data.audioSpeed is float || data.audioSpeed is int)
        && data.audioSpeed >= 0.65
        && data.audioSpeed <= 1.5
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLessonProgress(data, parentId, progressId) {
      return data.keys().hasAll([
          'progressId',
          'parentId',
          'learnerId',
          'lessonId',
          'learningLocale',
          'mode',
          'completedActivityIds',
          'totalActivities',
          'lastActivityIndex',
          'completed',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'progressId',
          'parentId',
          'learnerId',
          'lessonId',
          'learningLocale',
          'mode',
          'completedActivityIds',
          'totalActivities',
          'lastActivityIndex',
          'completed',
          'createdAt',
          'updatedAt'
        ])
        && data.parentId == request.auth.uid
        && data.parentId == parentId
        && data.progressId == progressId
        && isValidId(data.progressId)
        && isValidShortId(data.learnerId)
        && isValidShortId(data.lessonId)
        && isValidLocale(data.learningLocale)
        && data.mode is string
        && data.mode.size() <= 16
        && data.mode in ['guided', 'flashcards', 'listening', 'game', 'story', 'explore']
        && data.completedActivityIds is list
        && data.completedActivityIds.size() <= 50
        && (data.completedActivityIds.size() == 0 || (data.completedActivityIds[0] is string && data.completedActivityIds[0].size() <= 64))
        && data.totalActivities is int
        && data.totalActivities >= 1
        && data.totalActivities <= 100
        && data.lastActivityIndex is int
        && data.lastActivityIndex >= 0
        && data.lastActivityIndex <= 100
        && data.completed is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStoryPosition(data, parentId, positionId) {
      return data.keys().hasAll([
          'positionId',
          'parentId',
          'learnerId',
          'storyId',
          'narrationLocale',
          'segmentIndex',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'positionId',
          'parentId',
          'learnerId',
          'storyId',
          'narrationLocale',
          'segmentIndex',
          'createdAt',
          'updatedAt'
        ])
        && data.parentId == request.auth.uid
        && data.parentId == parentId
        && data.positionId == positionId
        && isValidId(data.positionId)
        && isValidShortId(data.learnerId)
        && isValidShortId(data.storyId)
        && isValidLocale(data.narrationLocale)
        && data.segmentIndex is int
        && data.segmentIndex >= 0
        && data.segmentIndex <= 200
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFamilyInvite(data, inviteCode) {
      return data.keys().hasAll([
          'inviteCode',
          'studentUid',
          'studentName',
          'ageYears',
          'ageBand',
          'gradeLevel',
          'status',
          'claimedByParentUid',
          'expiresAt',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'inviteCode',
          'studentUid',
          'studentName',
          'ageYears',
          'ageBand',
          'gradeLevel',
          'status',
          'claimedByParentUid',
          'expiresAt',
          'createdAt',
          'updatedAt'
        ])
        && data.inviteCode == inviteCode
        && isValidInviteCode(data.inviteCode)
        && isValidId(data.studentUid)
        && data.studentName is string
        && data.studentName.size() >= 1
        && data.studentName.size() <= 32
        && data.ageYears is int
        && data.ageYears >= 3
        && data.ageYears <= 18
        && isValidAgeBand(data.ageBand)
        && data.gradeLevel is int
        && data.gradeLevel >= 0
        && data.gradeLevel <= 12
        && data.status is string
        && data.status.size() <= 16
        && data.status in ['active', 'claimed', 'revoked']
        && data.claimedByParentUid is string
        && data.claimedByParentUid.size() <= 128
        && (data.claimedByParentUid == '' || isValidId(data.claimedByParentUid))
        && data.expiresAt is timestamp
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidObserverLink(data, linkId) {
      return data.keys().hasAll([
          'linkId',
          'parentUid',
          'studentUid',
          'parentDisplayName',
          'studentName',
          'ageYears',
          'ageBand',
          'gradeLevel',
          'avatarTone',
          'inviteCode',
          'completedLessonsCount',
          'totalActivitiesCompleted',
          'currentStreakDays',
          'dailyMinutesGoal',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'linkId',
          'parentUid',
          'studentUid',
          'parentDisplayName',
          'studentName',
          'ageYears',
          'ageBand',
          'gradeLevel',
          'avatarTone',
          'inviteCode',
          'completedLessonsCount',
          'totalActivitiesCompleted',
          'currentStreakDays',
          'dailyMinutesGoal',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.linkId == linkId
        && isValidId(data.linkId)
        && isValidId(data.parentUid)
        && isValidId(data.studentUid)
        && data.parentUid != data.studentUid
        && data.linkId == data.parentUid + '_' + data.studentUid
        && data.parentDisplayName is string
        && data.parentDisplayName.size() >= 1
        && data.parentDisplayName.size() <= 80
        && data.studentName is string
        && data.studentName.size() >= 1
        && data.studentName.size() <= 32
        && data.ageYears is int
        && data.ageYears >= 3
        && data.ageYears <= 18
        && isValidAgeBand(data.ageBand)
        && data.gradeLevel is int
        && data.gradeLevel >= 0
        && data.gradeLevel <= 12
        && data.avatarTone is string
        && data.avatarTone.size() <= 16
        && data.avatarTone in ['sky', 'amber', 'emerald', 'rose']
        && isValidInviteCode(data.inviteCode)
        && data.completedLessonsCount is int
        && data.completedLessonsCount >= 0
        && data.completedLessonsCount <= 5000
        && data.totalActivitiesCompleted is int
        && data.totalActivitiesCompleted >= 0
        && data.totalActivitiesCompleted <= 50000
        && data.currentStreakDays is int
        && data.currentStreakDays >= 0
        && data.currentStreakDays <= 3650
        && data.dailyMinutesGoal is int
        && data.dailyMinutesGoal >= 5
        && data.dailyMinutesGoal <= 180
        && data.status is string
        && data.status.size() <= 16
        && data.status in ['active', 'revoked']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /parents/{parentId} {
      allow get: if isVerifiedOwner(parentId) && isValidId(parentId);
      allow list: if false;
      allow create: if isVerifiedOwner(parentId)
        && isValidId(parentId)
        && isValidParentAccount(incoming(), parentId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedOwner(parentId)
        && isValidId(parentId)
        && isValidParentAccount(incoming(), parentId)
        && incoming().parentId == existing().parentId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['accountType', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'accountType', 'updatedAt'])
        );
      allow delete: if isVerifiedOwner(parentId) && isValidId(parentId);

      match /learners/{learnerId} {
        allow get: if isVerifiedOwner(parentId)
          && isValidId(parentId)
          && isValidShortId(learnerId)
          && parentExists(parentId);
        allow list: if isVerifiedOwner(parentId)
          && resource.data.parentId == request.auth.uid;
        allow create: if isVerifiedOwner(parentId)
          && isValidId(parentId)
          && isValidShortId(learnerId)
          && isValidLearnerProfile(incoming(), parentId, learnerId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && parentExists(parentId);
        allow update: if isVerifiedOwner(parentId)
          && isValidId(parentId)
          && isValidShortId(learnerId)
          && isValidLearnerProfile(incoming(), parentId, learnerId)
          && incoming().parentId == existing().parentId
          && incoming().learnerId == existing().learnerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'interfaceLocale',
              'learningLocale',
              'explanationLocale',
              'narrationLocale',
              'reducedMotion',
              'dailyMinutesLimit',
              'storyDailyMinutesLimit',
              'audioSpeed',
              'updatedAt'
            ])
            || incoming().diff(existing()).affectedKeys().hasOnly([
              'nickname',
              'ageYears',
              'ageBand',
              'gradeLevel',
              'avatarTone',
              'dailyMinutesLimit',
              'storyDailyMinutesLimit',
              'audioSpeed',
              'updatedAt'
            ])
          )
          && parentExists(parentId);
        allow delete: if isVerifiedOwner(parentId)
          && isValidId(parentId)
          && isValidShortId(learnerId)
          && parentExists(parentId);
      }

      match /progress/{progressId} {
        allow get: if isVerifiedOwner(parentId)
          && isValidId(parentId)
          && isValidId(progressId)
          && parentExists(parentId);
        allow list: if isVerifiedOwner(parentId)
          && resource.data.parentId == request.auth.uid;
        allow create: if isVerifiedOwner(parentId)
          && isValidId(parentId)
          && isValidId(progressId)
          && isValidLessonProgress(incoming(), parentId, progressId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && parentExists(parentId)
          && exists(/databases/$(database)/documents/parents/$(parentId)/learners/$(incoming().learnerId));
        allow update: if isVerifiedOwner(parentId)
          && isValidId(parentId)
          && isValidId(progressId)
          && isValidLessonProgress(incoming(), parentId, progressId)
          && incoming().parentId == existing().parentId
          && incoming().progressId == existing().progressId
          && incoming().learnerId == existing().learnerId
          && incoming().lessonId == existing().lessonId
          && incoming().learningLocale == existing().learningLocale
          && incoming().mode == existing().mode
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'completedActivityIds',
            'totalActivities',
            'lastActivityIndex',
            'completed',
            'updatedAt'
          ])
          && parentExists(parentId);
        allow delete: if isVerifiedOwner(parentId)
          && isValidId(parentId)
          && isValidId(progressId)
          && parentExists(parentId);
      }

      match /storyPositions/{positionId} {
        allow get: if isVerifiedOwner(parentId)
          && isValidId(parentId)
          && isValidId(positionId)
          && parentExists(parentId);
        allow list: if isVerifiedOwner(parentId)
          && resource.data.parentId == request.auth.uid;
        allow create: if isVerifiedOwner(parentId)
          && isValidId(parentId)
          && isValidId(positionId)
          && isValidStoryPosition(incoming(), parentId, positionId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && parentExists(parentId)
          && exists(/databases/$(database)/documents/parents/$(parentId)/learners/$(incoming().learnerId));
        allow update: if isVerifiedOwner(parentId)
          && isValidId(parentId)
          && isValidId(positionId)
          && isValidStoryPosition(incoming(), parentId, positionId)
          && incoming().parentId == existing().parentId
          && incoming().positionId == existing().positionId
          && incoming().learnerId == existing().learnerId
          && incoming().storyId == existing().storyId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'narrationLocale',
            'segmentIndex',
            'updatedAt'
          ])
          && parentExists(parentId);
        allow delete: if isVerifiedOwner(parentId)
          && isValidId(parentId)
          && isValidId(positionId)
          && parentExists(parentId);
      }
    }

    match /familyInvites/{inviteCode} {
      allow get: if isVerifiedUser() && isValidInviteCode(inviteCode);
      allow list: if isVerifiedUser()
        && resource.data.studentUid == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidInviteCode(inviteCode)
        && isValidFamilyInvite(incoming(), inviteCode)
        && incoming().studentUid == request.auth.uid
        && incoming().status == 'active'
        && incoming().claimedByParentUid == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().expiresAt > request.time
        && incoming().expiresAt <= request.time + duration.value(14, 'd')
        && parentExists(request.auth.uid);
      allow update: if isVerifiedUser()
        && isValidInviteCode(inviteCode)
        && isValidFamilyInvite(incoming(), inviteCode)
        && incoming().inviteCode == existing().inviteCode
        && incoming().studentUid == existing().studentUid
        && incoming().studentName == existing().studentName
        && incoming().ageYears == existing().ageYears
        && incoming().ageBand == existing().ageBand
        && incoming().gradeLevel == existing().gradeLevel
        && incoming().expiresAt == existing().expiresAt
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Student revokes own active code
          (
            existing().studentUid == request.auth.uid
            && existing().status == 'active'
            && incoming().status == 'revoked'
            && incoming().claimedByParentUid == ''
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
          // Action 2: Parent atomically claims active non-expired code alongside ObserverLink creation
          || (
            existing().studentUid != request.auth.uid
            && existing().status == 'active'
            && existing().expiresAt > request.time
            && incoming().status == 'claimed'
            && incoming().claimedByParentUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'claimedByParentUid',
              'updatedAt'
            ])
            && existsAfter(/databases/$(database)/documents/observerLinks/$(request.auth.uid + '_' + existing().studentUid))
          )
        );
      allow delete: if isVerifiedUser()
        && isValidInviteCode(inviteCode)
        && existing().studentUid == request.auth.uid;
    }

    match /observerLinks/{linkId} {
      allow get: if isVerifiedUser()
        && isValidId(linkId)
        && (existing().parentUid == request.auth.uid || existing().studentUid == request.auth.uid);
      allow list: if isVerifiedUser()
        && (resource.data.parentUid == request.auth.uid || resource.data.studentUid == request.auth.uid);
      allow create: if isVerifiedUser()
        && isValidId(linkId)
        && isValidObserverLink(incoming(), linkId)
        && incoming().parentUid == request.auth.uid
        && incoming().status == 'active'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && parentExists(request.auth.uid)
        && get(/databases/$(database)/documents/familyInvites/$(incoming().inviteCode)).data.studentUid == incoming().studentUid
        && get(/databases/$(database)/documents/familyInvites/$(incoming().inviteCode)).data.status == 'active'
        && get(/databases/$(database)/documents/familyInvites/$(incoming().inviteCode)).data.expiresAt > request.time
        && getAfter(/databases/$(database)/documents/familyInvites/$(incoming().inviteCode)).data.status == 'claimed'
        && getAfter(/databases/$(database)/documents/familyInvites/$(incoming().inviteCode)).data.claimedByParentUid == request.auth.uid;
      allow update: if isVerifiedUser()
        && isValidId(linkId)
        && isValidObserverLink(incoming(), linkId)
        && incoming().linkId == existing().linkId
        && incoming().parentUid == existing().parentUid
        && incoming().studentUid == existing().studentUid
        && incoming().inviteCode == existing().inviteCode
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Student updates read-only progress metrics snapshot
          (
            existing().studentUid == request.auth.uid
            && existing().status == 'active'
            && incoming().status == 'active'
            && incoming().parentDisplayName == existing().parentDisplayName
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'studentName',
              'ageYears',
              'ageBand',
              'gradeLevel',
              'avatarTone',
              'completedLessonsCount',
              'totalActivitiesCompleted',
              'currentStreakDays',
              'dailyMinutesGoal',
              'updatedAt'
            ])
          )
          // Action 2: Either student or parent revokes link
          || (
            (existing().studentUid == request.auth.uid || existing().parentUid == request.auth.uid)
            && existing().status == 'active'
            && incoming().status == 'revoked'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if isVerifiedUser()
        && isValidId(linkId)
        && (existing().parentUid == request.auth.uid || existing().studentUid == request.auth.uid);
    }
  }
}
